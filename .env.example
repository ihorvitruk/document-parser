# Copy to .env and fill in. Never commit .env.

# Required for summaries and the Gemini parser (Google AI Studio free tier).
GEMINI_API_KEY=

# Optional: enables the GPT-5 Mini parser.
OPENAI_API_KEY=

# Optional overrides (defaults shown).
# MAX_UPLOAD_MB=20
# DOCUMENT_TTL_HOURS=24
# LLM_MAX_ATTEMPTS=3
# PAGES_PER_CHUNK=5
# CLAIM_IDLE_SECONDS=120
# MAX_DELIVERIES=3
