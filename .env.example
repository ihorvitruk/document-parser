# Copy to .env and fill in. Never commit .env.
# After changing .env, apply it with: docker compose up -d

# Required for summaries and the Gemini parser (Google AI Studio free tier).
GEMINI_API_KEY=

# Optional: enables the GPT-5 Mini parser.
OPENAI_API_KEY=

# Optional overrides. Defaults are shown; uncomment a line to change it.

# Models
# GEMINI_MODEL=gemini-3.1-flash-lite
# OPENAI_MODEL=gpt-5-mini

# Uploads and storage
# MAX_UPLOAD_MB=20            # per file
# DOCUMENT_TTL_HOURS=24       # how long documents are kept in Redis

# LLM calls
# PAGES_PER_CHUNK=5           # pages sent to the LLM per request when parsing
# LLM_CONCURRENCY=3           # parallel LLM requests per document
# LLM_MAX_ATTEMPTS=3          # tries per LLM call on temporary errors
# LLM_TIMEOUT_SECONDS=120     # per attempt

# Worker queue
# CLAIM_IDLE_SECONDS=120      # a job idle this long is taken over by another worker
# MAX_DELIVERIES=3            # attempts before a repeatedly crashing job is failed
